# Copy to .env at repository root (monorepo — frontend + backend)
#   cp .env.example .env

# Next.js / Auth
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production server USB reader: NEXT_PUBLIC_CARD_API_PROXY=true (see deploy/.env.production.example)
# NEXT_PUBLIC_CARD_API_PROXY=false
# Production subpath (lib.kku.ac.th): NEXT_PUBLIC_BASE_PATH=/smart-access
NEXT_PUBLIC_BASE_PATH=
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_URL=http://localhost:3000/api/auth
# Docker on server (deploy/pick-host-port.sh sets these)
# FRONTEND_HOST_PORT=13010
# BACKEND_HOST_PORT=8000
QR_SECRET=change-me-min-8-chars

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/qr-accesscontrol?schema=public

# SQL Server (legacy / Pennueng — ทดสอบ: cd frontend && npm run test:sqlserver)
# SQLSERVER_HOST=
# SQLSERVER_PORT=1433
# SQLSERVER_DATABASE=
# SQLSERVER_USERNAME=
# SQLSERVER_PASSWORD=
# SQLSERVER_ENCRYPT=false
# SQLSERVER_TRUST_CERT=true

# reCAPTCHA
NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-N8GKD2MQYV
NEXT_PUBLIC_GA_STREAM_ID=14883816667
# Set to true to load GA in local dev (default: production only)
# NEXT_PUBLIC_GA_ENABLED=true

# Route usage logs
ROUTE_LOG_ENABLED=true
# NEXT_PUBLIC_ROUTE_LOG_ENABLED=false
ROUTE_LOG_INGEST_SECRET=change-me-route-log-secret
ROUTE_LOG_INGEST_URL=http://localhost:3000/api/logs/route

# Card API (Windows client with USB reader)
# CARD_API_PORT=8000
# CORS_ORIGINS=https://lib.kku.ac.th,http://localhost:3000,http://127.0.0.1:3000

# Optional: Google Cloud Translation API v2 (แปลชื่อไทย→อังกฤษ/จีนในฟอร์มสาขา) — ถ้าไม่ตั้งจะใช้ MyMemory (โควตาฟรีจำกัด)
# GOOGLE_TRANSLATE_API_KEY=

# Optional: PDPA modal — KKU regulation PDF (default: /pdpa-kku-2565.pdf in frontend/public/)
# NEXT_PUBLIC_PDPA_KKU_PDF_URL=/pdpa-kku-2565.pdf

# Optional: override admin password when running npm run seed:admin (from frontend/)
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_ROLE=SUPER_ADMIN

# SMTP Mail Settings (Nodemailer for sending QR codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KKU Library" <your-email@gmail.com>

