# ==============================================================================
# KKU Library Access Control Monorepo .gitignore
# ==============================================================================

# Dependency Directories
node_modules/
**/node_modules/
backend/venv/
backend/.venv/
ENV/
env/
/.pnp
.pnp.*

# Yarn specific
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Cache Directories
.next/
**/.next/
out/
dist/
build/
frontend/var/

# Python Cache & Compilation Files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
backend/pip-log.txt
backend/pip-delete-this-directory.txt

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/
*.lcov
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Development & Scratch Directories (Exclude dev scratch files)
scratch/
**/scratch/
test-*.ts
check-*.js
seed-direct.js
*Client_test*.tsx

# Environment Variables (Keep only .env.example)
.env
.env.local
.env.production
.env.development
.env.test
.env.prod
.env.*.local
!.env.example

# IDEs, Editors & Project Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/sftp.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Logs (root-level only — don't shadow app/api/logs/ route folders)
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database (Local Sqlite/Dev DB backups)
*.db
*.db-journal
/prisma/migrations
/prisma/generated/

# Database dumps & backups — never commit production data!
*.sql
backups/
*_dump.sql
production_dump.sql
