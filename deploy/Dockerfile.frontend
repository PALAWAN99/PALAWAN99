# Production Next.js (monorepo: build from frontend/, root .env for Prisma + NEXT_PUBLIC_*)
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat openssl \
  && npm install -g npm@11.15.0
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
# npm ci can fail when lock was generated on a different Node/npm than node:22-alpine
RUN npm install --no-audit --no-fund

FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat openssl \
  && npm install -g npm@11.15.0
ARG NEXT_PUBLIC_BASE_PATH=/smart-access
ARG NEXT_PUBLIC_CARD_API_PROXY=false
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=
ARG NEXT_PUBLIC_RECAPTCHA_ENFORCE=
ARG DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
ENV NEXT_PUBLIC_CARD_API_PROXY=$NEXT_PUBLIC_CARD_API_PROXY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY
ENV NEXT_PUBLIC_RECAPTCHA_ENFORCE=$NEXT_PUBLIC_RECAPTCHA_ENFORCE
ENV DATABASE_URL=$DATABASE_URL
WORKDIR /app
COPY --from=deps /app/frontend/node_modules ./frontend/node_modules
COPY frontend ./frontend
WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate
RUN npm run build

FROM node:22-alpine AS release
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./public
USER nextjs
EXPOSE 3000
# ENTRYPOINT (not CMD) — avoids duplicate-CMD hint from node:22-alpine default CMD
ENTRYPOINT ["node", "server.js"]
