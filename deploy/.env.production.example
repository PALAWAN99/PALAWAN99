# Production template — copy to repo root as `.env` on server, fill secrets, then chmod 600
# Upload to: /var/docker/smart-accesscontrol/.env
# Run: ./deploy/pick-host-port.sh before docker compose build

NODE_ENV=production

# PostgreSQL (existing server instance)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
# Origin only — Next.js basePath (/smart-access) is applied by the framework + auth redirect callback
AUTH_URL=https://lib.kku.ac.th
NEXTAUTH_URL=https://lib.kku.ac.th

# Subpath deploy
NEXT_PUBLIC_BASE_PATH=/smart-access

# QR signing
QR_SECRET=

# Docker host ports (pick-host-port.sh updates these)
FRONTEND_HOST_PORT=13010
BACKEND_HOST_PORT=8000

# Route logs
ROUTE_LOG_ENABLED=true
ROUTE_LOG_INGEST_SECRET=
ROUTE_LOG_INGEST_URL=https://lib.kku.ac.th/smart-access/api/logs/route

# Card API deployment (pick one):
# A) Reader on Windows PC at counter (default):
# CARD_API_ON_SERVER=false
# NEXT_PUBLIC_CARD_API_PROXY=false
#
# B) Reader USB on this Linux server:
CARD_API_ON_SERVER=true
NEXT_PUBLIC_CARD_API_PROXY=true
# Optional explicit URL (else browser uses https://lib.kku.ac.th/smart-access/card-api):
# NEXT_PUBLIC_API_URL=https://lib.kku.ac.th/smart-access/card-api
# CORS_ORIGINS=https://lib.kku.ac.th

# reCAPTCHA (if login uses it)
# NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=
# GOOGLE_RECAPTCHA_SECRET_KEY=

# Windows-only backend (.env on PC with card reader)
# CARD_API_PORT=8000
# CORS_ORIGINS=https://lib.kku.ac.th,http://localhost:3000
